            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "17 Uhr: Treffen im Kita-Garten",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "list_item",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "17:30 Uhr: Umzug durchs Dorf",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Treffpunkt ist an der ",
              "type": "text"
            },
            {
              "text": "neuen Schaukel",
