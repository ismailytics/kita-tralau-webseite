          "content": [
            {
              "text": "Am Martinstag ziehen wir mit Laternen durch Tralau. Alle Familien sind eingeladen.",
              "type": "text"
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
