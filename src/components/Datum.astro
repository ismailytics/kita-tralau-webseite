---
type Props = { datum: Date; class?: string };
const { datum, class: className } = Astro.props;
// UTC, weil die Inhaltsquelle reine Kalenderdaten als Mitternacht UTC liefert.
const text = new Intl.DateTimeFormat("de-DE", { dateStyle: "long", timeZone: "UTC" }).format(datum);
---

<time datetime={datum.toISOString().slice(0, 10)} class={className}>{text}</time>
