---
// Native <details>: auf- und zuklappbar ohne JavaScript, per Tastatur bedienbar.
import type { Faq } from "@/inhaltsquelle";

type Props = { fragen: Faq["fragen"] };
const { fragen } = Astro.props;
---

<div class="space-y-4 max-w-3xl mx-auto">
	{
		fragen.map(({ frage, antwort }) => (
			<details class="group border border-brand-foreground/15 rounded-2xl overflow-hidden">
				<summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden flex items-center justify-between p-5 text-left text-brand-foreground font-bold hover:bg-brand-foreground/5 transition-colors">
					{frage}
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
						class="ml-6 size-5 shrink-0 text-gray-500 transition-transform group-open:rotate-45"
					>
						<path d="M12 6v12m6-6H6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>
				<p class="px-5 pb-5 pt-1 whitespace-pre-line">{antwort}</p>
			</details>
		))
	}
</div>
