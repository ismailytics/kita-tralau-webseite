---
// Rendert ein Bild der Inhaltsquelle über astro:assets; Remote-Bilder werden beim Build geladen und same-origin ausgeliefert.
import { Image } from "astro:assets";
import type { Bild } from "@/inhaltsquelle";

type Props = { bild: Bild; class?: string; widths?: number[]; sizes?: string; loading?: "eager" | "lazy" };
const { bild, ...rest } = Astro.props;
---

{/* inferSize nur für Remote-URLs setzen; `false` landet sonst als Attribut im HTML. */}
<Image src={bild.src} alt={bild.alt} {...(typeof bild.src === "string" && { inferSize: true })} {...rest} />
