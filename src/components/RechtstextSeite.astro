---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import RichText from "@/components/RichText.astro";
import type { Rechtstext } from "@/inhaltsquelle";

type Props = { rechtstext: Rechtstext };
const { bearbeiten, titel, text } = Astro.props.rechtstext;
---

<Layout title={titel} bearbeiten={bearbeiten}>
	<Section>
		<Container>
			<article class="max-w-3xl mx-auto flex flex-col gap-y-6">
				<h1 class="text-5xl font-bold tracking-wide">{titel}</h1>
				<div class="prose prose-lg max-w-none">
					<RichText knoten={text} />
				</div>
			</article>
		</Container>
	</Section>
</Layout>
