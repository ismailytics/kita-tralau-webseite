---
import type { Termin } from "@/inhaltsquelle";

interface Props {
	termine: Termin[];
	/** Überschriftenebene der Termintitel, passend zur umgebenden Seite. */
	ebene?: "h2" | "h3";
}

const { termine, ebene: Titel = "h2" } = Astro.props;
const format = new Intl.DateTimeFormat("de-DE", { weekday: "short", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const datum = (iso: string) => new Date(`${iso}T00:00:00Z`);
---

<ol class="max-w-2xl mx-auto text-left">
	{
		termine.map((t) => (
			<li class="py-4 border-b border-gray-400/50 last:border-b-0" {...t.bearbeiten}>
				<p class="text-sm font-bold text-brand-blue">
					<time datetime={t.datum}>
						{t.enddatum ? format.formatRange(datum(t.datum), datum(t.enddatum)) : format.format(datum(t.datum))}
					</time>
					{t.uhrzeit && ` · ${t.uhrzeit}`}
				</p>
				<Titel class="text-xl font-bold">{t.titel}</Titel>
				{t.kurztext && <p>{t.kurztext}</p>}
			</li>
		))
	}
</ol>
