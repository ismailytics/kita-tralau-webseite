---
// PROTOTYP (wegwerfen) – B1 „Polaroid mit Sprechblase“:
// schräg aufgeklebtes Polaroid (Anklang an die Papierbuchstaben im Logo), daneben der Gruß als Sprechblase.
import Phone from "~icons/heroicons/phone";
import Envelope from "~icons/heroicons/envelope";
import Button from "@/components/buttons/Button.astro";
import Platzhalterfoto from "./Platzhalterfoto.astro";

const { telefon } = Astro.props as { telefon?: string };
---

<div class="mb-20 grid gap-12 md:grid-cols-[auto_1fr] items-center max-w-5xl mx-auto">
	<figure class="relative mx-auto w-64 md:w-72 -rotate-3 bg-white p-3 pb-4 rounded-sm shadow-xl">
		<span class="absolute -top-3 left-1/2 -translate-x-1/2 rotate-2 w-24 h-7 bg-brand-yellow/70" aria-hidden="true"></span>
		<Platzhalterfoto class="w-full aspect-square" />
		<figcaption class="mt-3 text-center font-fredoka text-xl font-semibold">
			Lara Spradau
			<span class="block text-base font-normal text-brand-foreground/70">Kita-Leitung</span>
		</figcaption>
	</figure>

	<div class="space-y-8">
		<h1 class="text-5xl font-bold tracking-wide text-center md:text-left">Kontakt</h1>
		<div class="relative bg-white rounded-3xl p-7 shadow-sm">
			<span
				class="hidden md:block absolute -left-3 top-10 size-6 rotate-45 bg-white"
				aria-hidden="true"
			></span>
			<p class="text-xl leading-relaxed">
				Schön, dass Sie uns kennenlernen möchten! Rufen Sie mich gern an. Dann vereinbaren wir einen Termin und
				ich zeige Ihnen unsere Kita.
			</p>
		</div>
		<div class="flex flex-wrap gap-3 justify-center md:justify-start">
			{
				telefon && (
					<Button variant="blue" href={`tel:${telefon.replace(/[^\d+]/g, "")}`}>
						<Phone aria-hidden="true" />
						{telefon}
					</Button>
				)
			}
			<Button variant="outline" href="#nachricht-schreiben">
				<Envelope aria-hidden="true" />
				Nachricht schreiben
			</Button>
		</div>
	</div>
</div>
