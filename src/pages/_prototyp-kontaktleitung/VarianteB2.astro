---
// PROTOTYP (wegwerfen) – B2 „Zentriert mit Farbkreis“:
// bleibt im zentrierten Rhythmus der anderen Seiten, rundes Foto vor versetztem Farbkreis, Rolle als Plakette.
import Phone from "~icons/heroicons/phone";
import Envelope from "~icons/heroicons/envelope";
import Button from "@/components/buttons/Button.astro";
import Platzhalterfoto from "./Platzhalterfoto.astro";

const { telefon } = Astro.props as { telefon?: string };
---

<div class="mb-20 flex flex-col items-center text-center gap-6 max-w-2xl mx-auto">
	<h1 class="text-5xl font-bold tracking-wide">Kontakt</h1>

	<div class="relative mt-4 mb-4">
		<span class="absolute -right-4 -top-3 size-48 md:size-56 rounded-full bg-brand-yellow" aria-hidden="true"></span>
		<span class="absolute -left-5 bottom-2 size-10 rounded-full bg-brand-red" aria-hidden="true"></span>
		<span class="absolute -right-8 bottom-10 size-6 rounded-full bg-brand-green" aria-hidden="true"></span>
		<Platzhalterfoto class="relative size-48 md:size-56 rounded-full ring-8 ring-white shadow-lg" />
		<span
			class="absolute left-1/2 -bottom-4 -translate-x-1/2 whitespace-nowrap rounded-full bg-brand-blue text-white text-base font-bold px-4 py-1.5 shadow"
		>
			Kita-Leitung
		</span>
	</div>

	<p class="font-fredoka text-3xl font-semibold mt-2">Lara Spradau</p>
	<p class="text-xl leading-relaxed text-balance">
		Schön, dass Sie uns kennenlernen möchten! Rufen Sie mich gern an. Dann vereinbaren wir einen Termin und ich zeige
		Ihnen unsere Kita.
	</p>
	<div class="flex flex-wrap gap-3 justify-center">
		{
			telefon && (
				<Button variant="blue" href={`tel:${telefon.replace(/[^\d+]/g, "")}`}>
					<Phone aria-hidden="true" />
					{telefon}
				</Button>
			)
		}
		<Button variant="outline" href="#nachricht-schreiben">
			<Envelope aria-hidden="true" />
			Nachricht schreiben
		</Button>
	</div>
	<p class="text-base text-brand-foreground/70">Fragen an den Verein beantwortet der Vorstand unter kitra.ev@web.de.</p>
</div>
