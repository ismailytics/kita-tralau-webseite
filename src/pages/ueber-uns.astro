---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import RichText from "@/components/RichText.astro";
import Bild from "@/components/Bild.astro";
import { ueberUns } from "@/inhaltsquelle";

const { bearbeiten, titel, intro, text, bilder } = await ueberUns();
---

<Layout title={titel} seoDescription={intro || undefined} bearbeiten={bearbeiten}>
	<Section>
		<Container>
			<article class="max-w-3xl mx-auto flex flex-col gap-y-6">
				<h1 class="text-5xl font-bold tracking-wide">{titel}</h1>
				{intro && <p class="text-xl">{intro}</p>}
				<div class="prose prose-lg max-w-none">
					<RichText knoten={text} />
				</div>
				{
					bilder.length > 0 && (
						<ul class="grid gap-4 sm:grid-cols-2">
							{bilder.map((b) => (
								<li>
									<Bild bild={b} class="aspect-[4/3] w-full rounded-2xl object-cover" widths={[400, 800]} sizes="(min-width: 768px) 24rem, 100vw" />
								</li>
							))}
						</ul>
					)
				}
			</article>
		</Container>
	</Section>
</Layout>
