---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import RichText from "@/components/RichText.astro";
import { ueberUns } from "@/inhaltsquelle";

const { bearbeiten, titel, intro, text } = await ueberUns();
---

<Layout title={titel} seoDescription={intro || undefined} bearbeiten={bearbeiten}>
	<Section>
		<Container>
			<article class="max-w-3xl mx-auto flex flex-col gap-y-6">
				<h1 class="text-5xl font-bold tracking-wide">{titel}</h1>
				{intro && <p class="text-xl">{intro}</p>}
				<div class="prose prose-lg max-w-none">
					<RichText knoten={text} />
				</div>
			</article>
		</Container>
	</Section>
</Layout>
