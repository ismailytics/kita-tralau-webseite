---
import { pfad } from "@/lib/pfad";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Bild from "@/components/Bild.astro";
import Datum from "@/components/Datum.astro";
import { beitraege, listenseite } from "@/inhaltsquelle";

const [{ bearbeiten, titel, intro }, liste] = await Promise.all([listenseite("aktuelles/"), beitraege()]);
---

<Layout title={titel} seoDescription={intro || undefined} bearbeiten={bearbeiten}>
	<Section>
		<Container>
			<SectionHeading>
				<h1 class="text-5xl font-bold tracking-wide">{titel}</h1>
				{intro && <p>{intro}</p>}
			</SectionHeading>
			<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
				{
					liste.map((b) => (
						<article class="flex flex-col gap-y-3" {...b.bearbeiten}>
							<Bild bild={b.teaserbild} class="aspect-[4/3] w-full object-cover rounded-lg" widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw" />
							<Datum datum={b.datum} class="text-sm text-gray-600" />
							<h2 class="text-2xl font-bold">
								<a href={pfad(`/aktuelles/${b.slug}`)} class="hover:text-brand-blue">{b.titel}</a>
							</h2>
							<p>{b.kurztext}</p>
						</article>
					))
				}
			</div>
		</Container>
	</Section>
</Layout>
